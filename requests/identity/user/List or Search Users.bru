meta {
  name: List or Search Users
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/identity/users
  body: none
  auth: bearer
}

params:query {
  ~q: Administrador
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should list users", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}
