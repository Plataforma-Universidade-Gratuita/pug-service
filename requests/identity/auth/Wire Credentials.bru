meta {
  name: Wire Credentials
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/auth/wire-credentials
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
