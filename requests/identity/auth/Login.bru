meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@pug.com",
    "password": "Admin123*"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("jwtToken", res.getBody().data.token);
    bru.setEnvVar("refreshToken", res.getBody().data.refreshToken);
  }
}


