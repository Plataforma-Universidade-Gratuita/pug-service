meta {
  name: Refresh
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("jwtToken", res.getBody().data.token);
  }
}


