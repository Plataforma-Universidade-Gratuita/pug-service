meta {
  name: Deactivate Admin
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/identity/admins/{{adminAccountId}}/deactivate
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should deactivate the admin account successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}
auth:bearer {
  token: {{jwtToken}}
}
