meta {
  name: List or Search Admins
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/identity/admins
  body: none
  auth: bearer
}

params:query {
  ~q: Administrador
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should list admins", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(Array.isArray(res.getBody().data)).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}
