meta {
  name: List or Search Courses
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/academic/courses
  body: none
  auth: none
}

params:query {
  ~q: Engenharia
  ~schoolId: {{schoolId}}
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should list courses successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(Array.isArray(res.getBody().data)).to.be.true;
  });
}
