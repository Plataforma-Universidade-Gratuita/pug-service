meta {
  name: Get Course
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/academic/courses/{{courseId}}
  body: none
  auth: none
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should retrieve the course successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data.id).to.equal(bru.getEnvVar("courseId"));
  });
}
