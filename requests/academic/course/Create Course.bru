meta {
  name: Create Course
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/academic/courses
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "name": "Engenharia de Software",
    "schoolId": "{{schoolId}}"
  }
}

tests {
  test("Should create a course successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data).to.have.property("id");

    // Save the created ID to the environment for student enrollment
    bru.setEnvVar("courseId", res.getBody().data.id);
  });
}
auth:bearer {
  token: {{jwtToken}}
}
