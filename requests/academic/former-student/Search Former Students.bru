meta {
  name: Search Former Students
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/academic/former-students/search?page=0&size=25
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "name": "Joao",
    "email": "joao",
    "academicRegistration": "2026",
    "campi": ["JOINVILLE"],
    "periodFrom": "2026-01-01",
    "periodTo": "2028-12-31",
    "includeConcluded": false,
    "activeOnly": true,
    "courseIds": ["00000000-0000-0000-0000-000000000001"],
    "areaOfExpertiseIds": ["00000000-0000-0000-0000-000000000001"]
  }
}
