meta {
  name: Update Former Student Status
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/v1/academic/former-students/00000000-0000-0000-0000-000000000001/status
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "active": true
  }
}
