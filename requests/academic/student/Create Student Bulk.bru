tests {
  test("Should bulk create students successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.be.true;
    expect(Array.isArray(res.getBody().data)).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}
