meta {
  name: Create Students Bulk
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/academic/students/bulk
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

