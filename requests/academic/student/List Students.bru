meta {
  name: List or Search Students
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/academic/students
  body: none
  auth: bearer
}

query {
  ~q: João
  ~courseId: {{courseId}}
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should list students successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(Array.isArray(res.getBody().data)).to.be.true;
  });
}
auth:bearer {
  token: {{jwtToken}}
}
