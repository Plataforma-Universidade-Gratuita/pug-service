}

get {
  url: {{baseUrl}}/academic/students/by-registration/20261001
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

docs {
  Toggle the URL to test different read operations:
  - {{baseUrl}}/academic/students/by-cpf/12345678900
  - {{baseUrl}}/academic/students/by-email/joao.silva@aluno.com
  - {{baseUrl}}/academic/students/by-registration/20261001
}

tests {
  test("Should retrieve the student successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}
auth:bearer {
  token: {{jwtToken}}
}
