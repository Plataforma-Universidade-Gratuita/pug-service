meta {
  name: Get Student By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/academic/students/{{studentAccountId}}
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should retrieve the student successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}
auth:bearer {
  token: {{jwtToken}}
}
