meta {
  name: Create Staff
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/partners/staff
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "cpf": "12345678909",
    "name": "Gestor da Parceria",
    "email": "gestor@techcorp.com",
    "entityId": "00000000-0000-0000-0000-000000000001"
  }
}

auth:bearer {
  token: {{jwtToken}}
}
