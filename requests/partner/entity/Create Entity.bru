meta {
  name: Create Entity
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/partner/entities
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "cnpj": "12345678000195",
    "name": "Tech Corp Parceira",
    "cityId": "00000000-0000-0000-0000-000000000001",
    "address": "Rua da Tecnologia, 100"
  }
}

auth:bearer {
  token: {{jwtToken}}
}
