meta {
  name: Get Project By ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/projects/{{projectId}}
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should get the project by ID", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

