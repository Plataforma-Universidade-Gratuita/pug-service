meta {
  name: Complete Project
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/complete
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should complete the project (COMPLETED)", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

