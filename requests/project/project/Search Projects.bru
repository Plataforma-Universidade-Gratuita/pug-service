meta {
  name: Search Projects
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/projects/search?page=0&size=25
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "name": "Projeto",
    "entityIds": ["00000000-0000-0000-0000-000000000001"],
    "description": "Extensao",
    "createdByIds": ["00000000-0000-0000-0000-000000000002"],
    "statuses": ["PLANNED"],
    "minOfferedHours": 10.00,
    "maxOfferedHours": 100.00
  }
}
