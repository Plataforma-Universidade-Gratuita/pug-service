meta {
  name: Update Project
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/projects/00000000-0000-0000-0000-000000000001
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "name": "Projeto Comunitário Alpha Atualizado",
    "description": "Descrição atualizada do projeto",
    "maxParticipants": 50,
    "offeredHours": 80.00
  }
}

auth:bearer {
  token: {{jwtToken}}
}
