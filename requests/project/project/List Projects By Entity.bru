meta {
  name: List Projects By Entity
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/projects?entityId={{entityId}}
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should list projects by entity", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

