meta {
  name: Start Project
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/start
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should start the project (IN_PROGRESS)", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

