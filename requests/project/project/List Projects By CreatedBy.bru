meta {
  name: List Projects By CreatedBy
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/projects/created-by/{{staffAccountId}}
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should list projects created by account", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

