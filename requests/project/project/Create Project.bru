meta {
  name: Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "name": "Projeto Comunitário Alpha",
    "entityId": "{{entityId}}",
    "description": "Projeto de extensão para atendimento comunitário",
    "maxParticipants": 30,
    "offeredHours": 60.00
  }
}

tests {
  test("Should create a project successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.be.true;
    bru.setEnvVar("projectId", res.getBody().data.id);
  });
}

auth:bearer {
  token: {{jwtToken}}
}

