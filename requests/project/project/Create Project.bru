meta {
  name: Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

body:json {
  {
    "name": "Projeto Comunitário Alpha",
    "entityId": "00000000-0000-0000-0000-000000000001",
    "description": "Projeto de extensão para atendimento comunitário",
    "maxParticipants": 30,
    "offeredHours": 60.00
  }
}

auth:bearer {
  token: {{jwtToken}}
}

