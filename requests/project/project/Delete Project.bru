meta {
  name: Delete Project
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/projects/{{projectId}}
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should delete the project successfully", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

