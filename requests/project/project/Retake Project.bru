meta {
  name: Retake Project
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/retake
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should retake the project from ON_HOLD", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

