meta {
  name: Hold Project
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/projects/{{projectId}}/hold
  body: none
  auth: bearer
}

headers {
  Accept-Language: pt-BR
}

tests {
  test("Should put the project on hold (ON_HOLD)", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

auth:bearer {
  token: {{jwtToken}}
}

