meta {
  name: Search Attendances
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/projects/attendances/search?page=0&size=25
  body: json
  auth: bearer
}

headers {
  Accept-Language: pt-BR
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "projectIds": ["00000000-0000-0000-0000-000000000001"],
    "formerStudentIds": ["00000000-0000-0000-0000-000000000002"],
    "statuses": ["WAITING"],
    "validatedByIds": ["00000000-0000-0000-0000-000000000003"],
    "durationFrom": 1.00,
    "durationTo": 8.00
  }
}
